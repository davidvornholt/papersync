{
  "name": "@papersync/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:a11y": "playwright test && playwright test --config playwright-managed.config.ts",
    "test:integration": "bun run --cwd ../../packages/db db:migrate && bun --env-file=.env.local test ./integration/homework.ts",
    "test:container": "bash scripts/container-smoke.sh"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/google-vertex": "^5.0.81",
    "@effect/sql": "^0.52.1",
    "@effect/sql-pg": "^0.53.0",
    "@papersync/db": "workspace:*",
    "@papersync/homework": "workspace:*",
    "@papersync/ui": "workspace:*",
    "@react-pdf/renderer": "^4.9.0",
    "ai": "^7.0.99",
    "better-auth": "^1.7.4",
    "bonjour-service": "^1.4.4",
    "effect": "^3.22.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "next": "^16.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@davidvornholt/a11y-testing": "workspace:*",
    "@davidvornholt/typescript-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "type": "module"
}
