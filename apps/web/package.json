{
  "name": "@papersync/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:a11y": "playwright test && playwright test --config playwright-scans.config.ts && playwright test --config playwright-managed.config.ts && playwright test --config playwright-settings.config.ts",
    "test:integration": "bun run --cwd ../../packages/db db:migrate && bun --env-file=.env.local test ./integration/homework.ts ./integration/corrections.ts ./integration/rescans.ts ./integration/settings.ts",
    "test:container": "bash scripts/container-smoke.sh"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.122",
    "@anthropic-ai/sdk": "^1.10.0",
    "@effect/sql-pg": "^4.1.4",
    "@papersync/db": "workspace:*",
    "@papersync/homework": "workspace:*",
    "@papersync/ui": "workspace:*",
    "@react-pdf/renderer": "^4.9.0",
    "ai": "^7.0.174",
    "better-auth": "^1.7.25",
    "bonjour-service": "^1.4.4",
    "effect": "^4.1.4",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@davidvornholt/a11y-testing": "workspace:*",
    "@davidvornholt/typescript-config": "workspace:*",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "fake-indexeddb": "6.2.8",
    "tailwindcss": "^4.3.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "type": "module"
}
