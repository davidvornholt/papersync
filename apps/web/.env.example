# Reference only. Configure config/dev.yaml and SOPS secrets/dev.yaml, then run
# bun standards dev-env. Do not put real secrets in this file or copy it to production.

# Required auth origin, allowed numeric GitHub ID, and public OAuth client ID. No defaults.
BETTER_AUTH_URL=http://localhost:3000
GITHUB_ALLOWED_ACCOUNT_ID=157214705
GITHUB_CLIENT_ID=replace-with-development-oauth-client-id
# Required secret values, owned by SOPS. No defaults; session key is at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-session-secret
GITHUB_CLIENT_SECRET=replace-with-development-oauth-client-secret
# Required PostgreSQL queue connection; match packages/db development configuration.
DATABASE_URL=postgresql://papersync:local-password@127.0.0.1:17435/papersync

# Optional managed OCR. Set all three together or omit all three; partial setup fails closed.
# No defaults. Locations are global, eu, or us. Model is fixed to Gemini 3.8 Flash/high in code.
# GOOGLE_VERTEX_PROJECT=your-gcp-project
# GOOGLE_VERTEX_LOCATION=global
# GOOGLE_VERTEX_CREDENTIALS_JSON={"type":"service_account","client_email":"papersync@example.iam.gserviceaccount.com","private_key":"replace-with-private-key"}
# GOOGLE_VERTEX_API_KEY is used only as an isolated test fixture to verify express mode is ignored.

# Optional browser-public device-flow client for repository vaults. Defaults to empty/disabled.
NEXT_PUBLIC_GITHUB_CLIENT_ID=
# Optional plugin ZIP path. The value below is also the runtime fallback.
PLUGIN_ARCHIVE_PATH=../super-productivity-plugin/dist/papersync-plugin.zip

# Framework/OS/tooling variables. Override only when needed; no app-specific fallback.
# PORT=3000
# HOSTNAME=127.0.0.1
# NODE_ENV=development
# TZ=Europe/Berlin
# HOME=/home/your-user
# PATH=/path/to/bun:/usr/bin:/bin
# CI=true
