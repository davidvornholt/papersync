{
  "name": "@papersync/root",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "turbo run lint check-types test",
    "check:fix": "turbo run lint:fix check-types test",
    "dev:web": "turbo run dev --filter @papersync/web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.3.13"
}
