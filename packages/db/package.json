{
  "name": "@papersync/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./runtime": "./src/runtime.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "bun test",
    "db:generate": "bun --env-file=.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local drizzle-kit migrate",
    "db:migrate:deploy": "drizzle-kit migrate"
  },
  "dependencies": {
    "@effect/sql": "^0.52.1",
    "@effect/sql-pg": "^0.53.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@davidvornholt/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2"
  }
}
