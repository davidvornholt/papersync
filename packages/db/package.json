{
  "name": "@papersync/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./runtime": "./src/runtime.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bun --env-file=.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local drizzle-kit migrate",
    "db:migrate:deploy": "drizzle-kit migrate"
  },
  "dependencies": {
    "@effect/sql-pg": "^4.0.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.6",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@davidvornholt/typescript-config": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
