{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test:a11y": {
      "dependsOn": [
        "build",
        "test"
      ],
      "env": [
        "CI",
        "DATABASE_URL"
      ],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "check:fix": {
      "dependsOn": [
        "^check:fix"
      ],
      "outputs": []
    },
    "@papersync/super-productivity-plugin#build": {
      "outputs": [
        "dist/**"
      ]
    },
    "@papersync/web#build": {
      "dependsOn": [
        "^build",
        "@papersync/super-productivity-plugin#build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "@papersync/web#test": {
      "dependsOn": [
        "^build",
        "test:integration"
      ],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL"
      ],
      "cache": false,
      "outputs": []
    }
  }
}
